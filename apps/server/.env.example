# Copy to .env, or let `bun create` do it. Treat these as secrets; never commit .env.
NODE_ENV=development

# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=replace-me-with-a-32-byte-hex-secret
BETTER_AUTH_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3001
DATABASE_URL=postgresql://postgres:password@localhost:5432/app

# Directory uploaded files are written to, served at /uploads
UPLOAD_DIR=./uploads

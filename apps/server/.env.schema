# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local, auto=not(forEnv(production)))
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @type=url
BETTER_AUTH_URL=

# @type=url
CORS_ORIGIN=

# @type=string(minLength=1)
DATABASE_URL=

# Where uploaded files are written. Relative paths resolve from the server app.
# @optional
UPLOAD_DIR=./uploads

# Assistant Gemini provider: auto selects AI Studio or Vertex from configured credentials.
# @optional @public @type=enum(auto, google, vertex)
GEMINI_PROVIDER=auto

# Default Gemini model ID (overrides provider default when set).
# @optional @public @type=string
GEMINI_MODEL=

# Comma-separated Gemini model IDs (optionally id|Label) exposed in the Assistant ModelSelector.
# @optional @public @type=string
GEMINI_MODELS=

# Google AI Studio API key (@ai-sdk/google).
# @optional
GOOGLE_GENERATIVE_AI_API_KEY=

# Google Cloud Vertex AI configuration (@ai-sdk/google-vertex).
# @optional @public @type=string
GOOGLE_VERTEX_PROJECT=

# @optional @public @type=string
GOOGLE_VERTEX_LOCATION=

# @optional
GOOGLE_VERTEX_API_KEY=

# @optional
GOOGLE_APPLICATION_CREDENTIALS=

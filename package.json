{
  "name": "monorepo-boilerplate",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.6.7",
      "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0",
      "typescript": "^6.0.3",
      "@types/bun": "^1.4.4",
      "varlock": "1.25.0",
      "@trpc/server": "^11.28.0",
      "better-auth": "1.7.22",
      "lucide-react": "^1.72.0",
      "next-themes": "^0.4.6",
      "react": "^19.3.1",
      "react-dom": "^19.3.1",
      "sonner": "^2.0.8",
      "@trpc/client": "^11.28.0",
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "tailwindcss": "^4.3.5",
      "drizzle-orm": "1.0.0-rc.5",
      "@assistant-ui/react": "^0.15.38",
      "@assistant-ui/ai-sdk": "^0.0.20",
      "@assistant-ui/tap": "^0.9.27",
      "assistant-stream": "^0.3.59",
      "ai": "^7.0.181"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "vp run -r dev",
    "build": "vp run -r build",
    "check-types": "vp run -r check-types",
    "check": "vp check && vp run -r check-types",
    "test": "bun test ./packages/ui/tests ./apps/server/tests ./.archon/workflows/factory/.shared ./.archon/workflows/factory/factory-slice/scripts",
    "lint": "vp lint",
    "format": "vp fmt",
    "staged": "vp staged",
    "hooks:setup": "vp config --hooks --hooks-dir .vite-hooks --no-agent",
    "prepare": "vp config --hooks --hooks-dir .vite-hooks --no-agent",
    "dev:web": "vp run --filter web dev",
    "dev:server": "vp run --filter server dev",
    "db:push": "vp run --filter @monorepo-boilerplate/db db:push",
    "db:studio": "vp run --filter @monorepo-boilerplate/db db:studio",
    "db:generate": "vp run --filter @monorepo-boilerplate/db db:generate",
    "db:migrate": "vp run --filter @monorepo-boilerplate/db db:migrate",
    "db:start": "docker compose up -d postgres",
    "db:watch": "docker compose up postgres",
    "db:stop": "docker compose stop postgres",
    "db:down": "docker compose down postgres",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "setup": "bun scripts/setup.ts",
    "env:init": "bun scripts/env-init.ts",
    "rename": "bun scripts/rename.ts",
    "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
    "postinstall": "bun scripts/env-init.ts && varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
    "auth:generate": "cd apps/server && bun run auth:generate",
    "db:seed": "vp run --filter @monorepo-boilerplate/db db:seed"
  },
  "devDependencies": {
    "@monorepo-boilerplate/config": "workspace:*",
    "@types/bun": "catalog:",
    "rolldown": "1.3.2",
    "typescript": "catalog:",
    "varlock": "catalog:",
    "vite": "catalog:",
    "vite-plus": "1.6.0"
  },
  "overrides": {
    "vite": "$vite"
  },
  "packageManager": "bun@1.4.5",
  "bun-create": {
    "start": "bun run dev"
  }
}
